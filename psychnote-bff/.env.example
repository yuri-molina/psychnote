# Porta em que o BFF escuta
PORT=4000

# URL base do psychnote-core
CORE_URL=http://localhost:8000

# Timeout para chamadas ao Core em milissegundos (60 segundos)
CORE_TIMEOUT_MS=60000

# Origens CORS permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5001

# Ambiente de execução
NODE_ENV=development
